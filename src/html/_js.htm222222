  // =====================================================
  // 1. СТАРЫЙ СЛАЙДЕР — только для safety и documents
  // =====================================================

  class LegacyCustomSlider {
    constructor(wrapperSelector, breakpoints = [], itemsPerSlide = [], gap = 10) {
      this.wrapper = document.querySelector(wrapperSelector);

      // Если блока нет — просто выходим без ошибки в консоли
      if (!this.wrapper) return;

      this.slider = this.wrapper.querySelector('.custom-slider');
      this.items = Array.from(this.wrapper.querySelectorAll('.custom-item'));
      this.navPrev = this.wrapper.querySelector('.slider-nav__btn--prev');
      this.navNext = this.wrapper.querySelector('.slider-nav__btn--next');

      if (!this.slider || !this.items.length) return;

      this.breakpoints = breakpoints;
      this.itemsPerSlide = itemsPerSlide;
      this.currentSlideIndex = 0;
      this.totalSlides = 0;
      this.gap = gap;

      this.slider.style.display = 'flex';
      this.slider.style.gap = `${this.gap}px`;

      this.init();
    }

    init() {
      window.addEventListener('resize', () => this.updateSlider());
      this.updateSlider();

      if (this.navPrev && this.navNext) {
        this.navPrev.addEventListener('click', () => this.moveSlide(-1));
        this.navNext.addEventListener('click', () => this.moveSlide(1));
      }
    }

    getItemsPerSlide() {
      if (!this.breakpoints.length) {
        return this.itemsPerSlide.length ? this.itemsPerSlide[0] : 1;
      }

      const width = window.innerWidth;

      for (let i = 0; i < this.breakpoints.length; i++) {
        if (width <= this.breakpoints[i]) {
          return this.itemsPerSlide[i];
        }
      }

      return null;
    }

    updateSlider() {
      const itemsPerSlide = this.getItemsPerSlide();

      if (itemsPerSlide === null) {
        this.disableSlider();
      } else {
        this.rebuildSlides(itemsPerSlide);

        this.slider.style.display = 'flex';
        this.slider.style.gap = `${this.gap}px`;

        this.currentSlideIndex = 0;
        this.updateTransform();
      }
    }

    rebuildSlides(itemsPerSlide) {
      this.slider.innerHTML = '';

      const slides = [];

      for (let i = 0; i < this.items.length; i += itemsPerSlide) {
        const slide = document.createElement('div');
        slide.classList.add('custom-slider-slide');

        this.items.slice(i, i + itemsPerSlide).forEach((item) => {
          slide.appendChild(item.cloneNode(true));
        });

        slides.push(slide);
      }

      slides.forEach((slide) => this.slider.appendChild(slide));

      this.slides = Array.from(this.slider.querySelectorAll('.custom-slider-slide'));
      this.totalSlides = this.slides.length;

      this.slider.style.transition = 'transform 0.5s ease';
      this.slider.style.transform = 'translateX(0)';
    }

    moveSlide(direction) {
      this.currentSlideIndex += direction;

      if (this.currentSlideIndex < 0) {
        this.currentSlideIndex = this.totalSlides - 1;
      } else if (this.currentSlideIndex >= this.totalSlides) {
        this.currentSlideIndex = 0;
      }

      this.updateTransform();
    }

    updateTransform() {
      const translateX = -(
        this.currentSlideIndex *
        (100 + (this.gap / this.wrapper.offsetWidth) * 100)
      );

      this.slider.style.transform = `translateX(${translateX}%)`;
    }

    disableSlider() {
      this.slider.innerHTML = '';

      this.items.forEach((item) => {
        this.slider.appendChild(item.cloneNode(true));
      });

      this.slider.style.removeProperty('transform');
      this.slider.style.removeProperty('transition');
      this.slider.style.removeProperty('gap');

      this.slider.style.display = 'grid';
    }
  }


  // =====================================================
  // 2. НОВЫЙ СЛАЙДЕР — для остальных блоков
  // =====================================================

  class SimpleCustomSlider {
    constructor(wrapperSelector, breakpoints = [], itemsPerSlide = [], gap = 10) {
      this.wrapper = document.querySelector(wrapperSelector);

      if (!this.wrapper) return;

      this.slider = this.wrapper.querySelector('.custom-slider');
      this.items = Array.from(this.wrapper.querySelectorAll('.custom-item'));
      this.navPrev = this.wrapper.querySelector('.slider-nav__btn--prev');
      this.navNext = this.wrapper.querySelector('.slider-nav__btn--next');

      if (!this.slider || !this.items.length) return;

      this.breakpoints = breakpoints;
      this.itemsPerSlide = itemsPerSlide;
      this.currentSlideIndex = 0;
      this.totalSlides = 0;
      this.gap = gap;
      this.slides = [];

      this.init();
    }

    init() {
      window.addEventListener('resize', () => this.updateSlider());

      if (this.navPrev) {
        this.navPrev.addEventListener('click', () => this.moveSlide(-1));
      }

      if (this.navNext) {
        this.navNext.addEventListener('click', () => this.moveSlide(1));
      }

      this.updateSlider();
    }

    getItemsPerSlide() {
      const width = window.innerWidth;

      if (!this.breakpoints.length) {
        return this.itemsPerSlide[0] || 1;
      }

      for (let i = 0; i < this.breakpoints.length; i++) {
        if (width <= this.breakpoints[i]) {
          return this.itemsPerSlide[i] || 1;
        }
      }

      return null;
    }

    updateSlider() {
      const itemsPerSlide = this.getItemsPerSlide();

      if (itemsPerSlide === null) {
        this.disableSlider();
        return;
      }

      this.rebuildSlides(itemsPerSlide);

      this.slider.style.display = 'flex';
      this.slider.style.gap = `${this.gap}px`;

      this.currentSlideIndex = 0;
      this.updateTransform();
      this.updateNav();
    }

    rebuildSlides(itemsPerSlide) {
      this.slider.innerHTML = '';

      for (let i = 0; i < this.items.length; i += itemsPerSlide) {
        const slide = document.createElement('div');
        slide.classList.add('custom-slider-slide');

        this.items.slice(i, i + itemsPerSlide).forEach((item) => {
          slide.appendChild(item.cloneNode(true));
        });

        this.slider.appendChild(slide);
      }

      this.slides = Array.from(this.slider.querySelectorAll('.custom-slider-slide'));
      this.totalSlides = this.slides.length;

      this.slider.style.transition = 'transform 0.5s ease';
      this.slider.style.transform = 'translateX(0)';
    }

    moveSlide(direction) {
      if (this.totalSlides <= 1) return;

      this.currentSlideIndex += direction;

      if (this.currentSlideIndex < 0) {
        this.currentSlideIndex = this.totalSlides - 1;
      } else if (this.currentSlideIndex >= this.totalSlides) {
        this.currentSlideIndex = 0;
      }

      this.updateTransform();
      this.updateNav();
    }

    updateTransform() {
      const translateX = -(
        this.currentSlideIndex *
        (100 + (this.gap / this.wrapper.offsetWidth) * 100)
      );

      this.slider.style.transform = `translateX(${translateX}%)`;
    }

    updateNav() {
      const isDisabled = this.totalSlides <= 1;

      if (this.navPrev) {
        this.navPrev.disabled = isDisabled;
      }

      if (this.navNext) {
        this.navNext.disabled = isDisabled;
      }
    }

    disableSlider() {
      this.slider.innerHTML = '';

      this.items.forEach((item) => {
        this.slider.appendChild(item.cloneNode(true));
      });

      this.slider.style.removeProperty('transform');
      this.slider.style.removeProperty('transition');
      this.slider.style.removeProperty('gap');

      this.slider.style.display = 'grid';

      this.currentSlideIndex = 0;
      this.totalSlides = 0;
      this.slides = [];

      this.updateNav();
    }
  }


  // =====================================================
  // 3. ИНИЦИАЛИЗАЦИЯ
  // =====================================================

  document.addEventListener('DOMContentLoaded', () => {
    // Старый рабочий слайдер — только эти два блока
    new LegacyCustomSlider('.safety__slider-wrapper', [768, 1280], [2, 4], 20);
    new LegacyCustomSlider('.documents__slider-wrapper', [768, 1280], [2, 3], 20);

    // Новый отдельный слайдер — остальные блоки
    new SimpleCustomSlider('.quantity__slider-wrapper', [], [1], 0);
    new SimpleCustomSlider('.teachers__slider-wrapper', [767], [1], 0);
    new SimpleCustomSlider('.events__calendar-slider', [], [1], 0);
  });

  class FadeSlider {
    constructor(root) {
      this.root = root;
      this.slides = Array.from(this.root.querySelectorAll('[data-fade-slide]'));
      this.prevBtn = this.root.querySelector('[data-fade-prev]');
      this.nextBtn = this.root.querySelector('[data-fade-next]');
      this.currentIndex = 0;

      this.autoplayDelay = this.getAutoplayDelay();
      this.autoplayTimer = null;

      if (!this.slides.length) return;

      this.init();
    }

    getAutoplayDelay() {
      if (!this.root.hasAttribute('data-fade-autoplay')) {
        return 0;
      }

      const value = Number(this.root.getAttribute('data-fade-autoplay'));

      return Number.isFinite(value) && value > 0 ? value : 5000;
    }

    init() {
      const activeIndex = this.slides.findIndex((slide) => slide.classList.contains('is-active'));

      this.currentIndex = activeIndex >= 0 ? activeIndex : 0;
      this.showSlide(this.currentIndex);

      if (this.prevBtn) {
        this.prevBtn.addEventListener('click', () => {
          this.moveSlide(-1);
          this.restartAutoplay();
        });
      }

      if (this.nextBtn) {
        this.nextBtn.addEventListener('click', () => {
          this.moveSlide(1);
          this.restartAutoplay();
        });
      }

      this.initAutoplay();
    }

    moveSlide(direction) {
      this.currentIndex += direction;

      if (this.currentIndex < 0) {
        this.currentIndex = this.slides.length - 1;
      }

      if (this.currentIndex >= this.slides.length) {
        this.currentIndex = 0;
      }

      this.showSlide(this.currentIndex);
    }

    showSlide(index) {
      this.slides.forEach((slide) => {
        slide.classList.remove('is-active');
      });

      this.slides[index].classList.add('is-active');
    }

    initAutoplay() {
      if (!this.autoplayDelay || this.slides.length < 2) return;

      this.startAutoplay();

      this.root.addEventListener('mouseenter', () => {
        this.stopAutoplay();
      });

      this.root.addEventListener('mouseleave', () => {
        this.startAutoplay();
      });

      document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
          this.stopAutoplay();
        } else {
          this.startAutoplay();
        }
      });
    }

    startAutoplay() {
      if (!this.autoplayDelay || this.slides.length < 2) return;

      this.stopAutoplay();

      this.autoplayTimer = setInterval(() => {
        this.moveSlide(1);
      }, this.autoplayDelay);
    }

    stopAutoplay() {
      if (this.autoplayTimer) {
        clearInterval(this.autoplayTimer);
        this.autoplayTimer = null;
      }
    }

    restartAutoplay() {
      if (!this.autoplayDelay) return;

      this.startAutoplay();
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('[data-fade-slider]').forEach((slider) => {
      new FadeSlider(slider);
    });
  });

  class ScrollCardsSlider {
    constructor(selector) {
      this.slider = document.querySelector(selector);

      if (!this.slider) return;

      this.track = this.slider.querySelector('.price__track');
      this.cards = Array.from(this.slider.querySelectorAll('.price-card'));
      this.prevBtn = this.slider.querySelector('.slider-nav__btn--prev');
      this.nextBtn = this.slider.querySelector('.slider-nav__btn--next');

      this.mobileMedia = window.matchMedia('(max-width: 767.98px)');
      this.resizeObserver = null;

      this.touchStartIndex = 0;
      this.touchStartX = 0;
      this.touchStartY = 0;
      this.snapTimer = null;

      this.scrollTopOffset = 90;

      if (!this.track || !this.cards.length || !this.prevBtn || !this.nextBtn) return;

      this.init();
    }

    init() {
      this.prevBtn.addEventListener('click', () => this.scroll(-1));
      this.nextBtn.addEventListener('click', () => this.scroll(1));

      this.track.addEventListener('scroll', () => {
        this.updateButtons();
        this.updateAutoHeight();

        if (this.mobileMedia.matches) {
          this.scheduleSnapToSlide();
        }
      });

      this.track.addEventListener('touchstart', (e) => {
        if (!this.mobileMedia.matches) return;

        this.touchStartIndex = this.getCurrentIndex();
        this.touchStartX = e.touches[0].clientX;
        this.touchStartY = e.touches[0].clientY;

        clearTimeout(this.snapTimer);
      }, { passive: true });

      this.track.addEventListener('touchend', (e) => {
        if (!this.mobileMedia.matches) return;

        const touchEndX = e.changedTouches[0].clientX;
        const touchEndY = e.changedTouches[0].clientY;

        const diffX = this.touchStartX - touchEndX;
        const diffY = this.touchStartY - touchEndY;

        const absX = Math.abs(diffX);
        const absY = Math.abs(diffY);

        const horizontalThreshold = 45;

        // Если жест больше похож на вертикальный скролл страницы — ничего не делаем
        if (absY > absX) return;

        // Если горизонтального движения почти не было — ничего не делаем
        if (absX < 15) return;

        let targetIndex = this.touchStartIndex;

        if (absX > horizontalThreshold) {
          targetIndex = diffX > 0
            ? this.touchStartIndex + 1
            : this.touchStartIndex - 1;
        } else {
          targetIndex = this.getCurrentIndex();
        }

        targetIndex = this.clampIndex(targetIndex);

        const slideChanged = targetIndex !== this.touchStartIndex;

        this.goToSlide(targetIndex);

        if (slideChanged) {
          setTimeout(() => {
            this.scrollPageToSliderTop();
          }, 250);
        }
      }, { passive: true });

      window.addEventListener('resize', () => {
        this.updateButtons();
        this.updateAutoHeight();
        this.goToSlide(this.getCurrentIndex(), false);
      });

      if (this.mobileMedia.addEventListener) {
        this.mobileMedia.addEventListener('change', () => {
          this.updateAutoHeight();
          this.goToSlide(this.getCurrentIndex(), false);
        });
      } else {
        this.mobileMedia.addListener(() => {
          this.updateAutoHeight();
          this.goToSlide(this.getCurrentIndex(), false);
        });
      }

      this.initResizeObserver();

      this.updateButtons();
      this.updateAutoHeight();

      window.addEventListener('load', () => {
        this.updateButtons();
        this.updateAutoHeight();
        this.goToSlide(this.getCurrentIndex(), false);
      });

      if (document.fonts) {
        document.fonts.ready.then(() => {
          this.updateButtons();
          this.updateAutoHeight();
          this.goToSlide(this.getCurrentIndex(), false);
        });
      }
    }

    clampIndex(index) {
      return Math.max(0, Math.min(index, this.cards.length - 1));
    }

    getGap() {
      const styles = window.getComputedStyle(this.track);
      return parseFloat(styles.columnGap || styles.gap) || 0;
    }

    getStep() {
      if (!this.cards[0]) return 0;

      return this.cards[0].offsetWidth + this.getGap();
    }

    getCurrentIndex() {
      const step = this.getStep();

      if (!step) return 0;

      const index = Math.round(this.track.scrollLeft / step);

      return this.clampIndex(index);
    }

    getSlideLeft(index) {
      return this.getStep() * this.clampIndex(index);
    }

    goToSlide(index, smooth = true) {
      const targetIndex = this.clampIndex(index);

      this.track.scrollTo({
        left: this.getSlideLeft(targetIndex),
        behavior: smooth ? 'smooth' : 'auto'
      });

      setTimeout(() => {
        this.updateButtons();
        this.updateAutoHeight();
      }, smooth ? 250 : 0);
    }

    scroll(direction) {
      const currentIndex = this.getCurrentIndex();
      const targetIndex = this.clampIndex(currentIndex + direction);

      if (targetIndex === currentIndex) return;

      this.goToSlide(targetIndex);

      setTimeout(() => {
        this.scrollPageToSliderTop();
      }, 250);
    }

    scheduleSnapToSlide() {
      clearTimeout(this.snapTimer);

      this.snapTimer = setTimeout(() => {
        this.goToSlide(this.getCurrentIndex());
      }, 180);
    }

    scrollPageToSliderTop() {
      if (!this.mobileMedia.matches) return;

      const trackTop = this.track.getBoundingClientRect().top;
      const targetTop = window.pageYOffset + trackTop - this.scrollTopOffset;

      window.scrollTo({
        top: targetTop,
        behavior: 'smooth'
      });
    }

    updateButtons() {
      const maxScrollLeft = this.track.scrollWidth - this.track.clientWidth;
      const currentScrollLeft = this.track.scrollLeft;

      this.prevBtn.disabled = currentScrollLeft <= 2;
      this.nextBtn.disabled = currentScrollLeft >= maxScrollLeft - 2;
    }

    updateAutoHeight() {
      if (!this.mobileMedia.matches) {
        this.track.style.height = '';
        return;
      }

      const currentCard = this.cards[this.getCurrentIndex()];

      if (!currentCard) return;

      this.track.style.height = `${currentCard.offsetHeight + 4}px`;
    }

    initResizeObserver() {
      if (!window.ResizeObserver) return;

      this.resizeObserver = new ResizeObserver(() => {
        this.updateAutoHeight();
      });

      this.cards.forEach((card) => {
        this.resizeObserver.observe(card);
      });
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    new ScrollCardsSlider('.price__slider');
  });

  document.addEventListener("DOMContentLoaded", () => {
    // Определяем массивы цветов для разных классов
    const colorSets = {
      "documents-item": [
        "#d3e2ff",
        "#ffebd0",
        "#f0deff",
        "#d8ffdc",
        "#f0deff",
        "#ffd0d0",
        "#d3e2ff",
        "#ffebd0",
        "#d8ffdc",
      ],
      "safety-item": [
        "linear-gradient(180deg, #d3e2ff 0%, #bfe9ff 100%)",
        "linear-gradient(180deg, #ffebd0 0%, #ffdfb2 100%)",
        "linear-gradient(180deg, #f0deff 0%, #dfb8ff 100%)",
        "linear-gradient(180deg, #d8ffdc 0%, #bfffc5 100%)",
        "linear-gradient(180deg, #d3d4ff 0%, #b5b7ff 100%)",
        "linear-gradient(180deg, #ffd0d0 0%, #ffb1b1 100%)",
        "linear-gradient(180deg, #ffebd0 0%, #ffdfb2 100%)",
        "linear-gradient(180deg, #d8ffdc 0%, #bfffc5 100%)",
        "linear-gradient(180deg, #d3e2ff 0%, #bfe9ff 100%)",
      ],
    };

    function assignColorsToClass(className, colors) {
      const items = document.querySelectorAll(`.${className}`);

      // Сбрасываем цвета перед пересчетом
      items.forEach((item) => {
        item.style.background = "";
      });

      // Присваиваем цвета циклично
      items.forEach((item, index) => {
        const colorIndex = index % colors.length;
        item.style.background = colors[colorIndex];
      });
    }

    function assignColors() {
      // Применяем цвета ко всем наборам классов
      for (const [className, colors] of Object.entries(colorSets)) {
        assignColorsToClass(className, colors);
      }
    }

    // Выполнить при загрузке страницы
    assignColors();

    // Выполнить при изменении размера окна
    window.addEventListener("resize", assignColors);
  });

  // Intersection Observer для fade-in
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          // Если это простой fade-in, добавляем show
          if (entry.target.classList.contains('fade-in')) {
            entry.target.classList.add('show');
          }

          // Если это fade-in-parent, обрабатываем дочерние элементы
          if (entry.target.classList.contains('fade-in-parent')) {
            const children = entry.target.querySelectorAll('.fade-in-child');
            children.forEach((child, index) => {
              // Добавляем задержку для дочерних элементов
              child.style.transitionDelay = `${index * 0.2}s`;
              child.classList.add('show');
            });
          }

          // Перестаем отслеживать элемент после анимации
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1 }
  ); // Срабатывание при 10% видимости элемента

  // Подключаем к нужным элементам
  document.querySelectorAll('.fade-in, .fade-in-parent').forEach((el) => {
    observer.observe(el);
  });

  // Анимация тегов
  document.addEventListener("DOMContentLoaded", () => {
    let activeAnimation = false; // Переменная для контроля активного состояния анимации
    let animationIntervals = []; // Сохраняем интервалы для управления их отключением

    function startAnimation() {
      if (activeAnimation) return; // Если анимация уже запущена, выходим
      activeAnimation = true;

      const rows = document.querySelectorAll(".process__tags-row");

      rows.forEach((row) => {
        const isReversing = row.classList.contains("process__tags-row_right"); // Определяем направление движения
        const rowWidth = row.scrollWidth; // Ширина строки
        let position = isReversing ? -rowWidth : 0; // Начальная позиция

        // Дублируем содержимое для бесконечной прокрутки
        row.innerHTML += row.innerHTML;

        function animate() {
          if (isReversing) {
            position += 1; // Движение вправо
            if (position >= 0) {
              position = -rowWidth; // Сбрасываем позицию
            }
          } else {
            position -= 1; // Движение влево
            if (Math.abs(position) >= rowWidth) {
              position = 0; // Сбрасываем позицию
            }
          }

          row.style.transform = `translateX(${position}px)`; // Применяем анимацию
        }

        // Устанавливаем интервал для анимации
        const interval = setInterval(animate, 13); // 20ms для плавности
        animationIntervals.push(interval); // Сохраняем интервал
      });
    }

    function stopAnimation() {
      if (!activeAnimation) return; // Если анимация уже отключена, выходим
      activeAnimation = false;

      // Очищаем все интервалы
      animationIntervals.forEach((interval) => clearInterval(interval));
      animationIntervals = []; // Сбрасываем список интервалов

      // Сбрасываем стили transform для всех строк
      const rows = document.querySelectorAll(".process__tags-row");
      rows.forEach((row) => {
        row.style.transform = "none";
        row.innerHTML = row.innerHTML.slice(0, row.innerHTML.length / 2); // Убираем дублированный контент
      });
    }

    function handleResize() {
      if (window.innerWidth <= 1280) {
        startAnimation(); // Запускаем анимацию на мобильных разрешениях
      } else {
        stopAnimation(); // Останавливаем анимацию на больших экранах
      }
    }

    // Инициализация
    handleResize();
    window.addEventListener("resize", handleResize);
  });

</script>