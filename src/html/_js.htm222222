<script src="js/app.min.js"></script>

<script>

  document.addEventListener("DOMContentLoaded", () => {
    const bgVideoBlocks = document.querySelectorAll("[data-bg-video]");

    if (!bgVideoBlocks.length) return;

    bgVideoBlocks.forEach((block) => {
      const video = block.querySelector(".js-bg-video");
      const placeholder = block.querySelector(".js-bg-placeholder");
      const slide = block.closest("[data-fade-slide]");

      if (!video) return;

      video.muted = true;
      video.playsInline = true;
      video.setAttribute("muted", "");
      video.setAttribute("playsinline", "");

      const showVideo = () => {
        if (placeholder) {
          placeholder.classList.add("is-hidden");
        }

        video.classList.add("is-visible");
      };

      const isSlideActive = () => {
        if (!slide) return true;
        return slide.classList.contains("is-active");
      };

      const playVideo = () => {
        if (!isSlideActive()) {
          video.pause();
          return;
        }

        video.play().catch((error) => {
          console.warn("Не удалось автоматически запустить фоновое видео:", error);
        });
      };

      const onVideoReady = () => {
        showVideo();
        playVideo();
      };

      video.addEventListener("loadeddata", onVideoReady, { once: true });

      if (video.readyState >= 3) {
        onVideoReady();
      }

      if (placeholder) {
        placeholder.addEventListener("click", () => {
          showVideo();
          playVideo();
        });
      }

      if (slide) {
        const observer = new MutationObserver(() => {
          if (isSlideActive()) {
            playVideo();
          } else {
            video.pause();
          }
        });

        observer.observe(slide, {
          attributes: true,
          attributeFilter: ["class"],
        });
      }
    });
  });

